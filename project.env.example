# Copy to project.env (gitignored) and fill in. Consumed by env/sync.sh.
#
# Authentication is SSH key only — there is no password, and no secret belongs
# in this file. SSH_KEY is a path to a key that stays in ~/.ssh.

# user@host of the execution VM.
REMOTE=ubuntu@0.0.0.0

# Path to the private key authorised on that host.
SSH_KEY=$HOME/.ssh/id_ed25519

# Where the repo is deployed on the VM.
REMOTE_ROOT=/mnt/src/agentic-design

# Interpreter with RFdiffusion installed.
REMOTE_PYTHON=/mnt/src/rfdiff-venv/bin/python
