{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "co-scientist",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "*": "deny",
    "research_*": "allow",
    "research_approve_experiment": "ask",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "bash": "ask",
    "edit": "ask",
    "write": "ask",
    "patch": "ask",
    "apply_patch": "ask"
  },
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true }
  }
}
